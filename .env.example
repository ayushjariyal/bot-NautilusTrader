# Copy this file to .env and adjust. The real .env is ignored by git.
#
# Required. The only allowed value is TESTNET. The app refuses to start without it,
# because NautilusTrader's Bybit adapter would otherwise connect to MAINNET.
BYBIT_ENVIRONMENT=TESTNET

# Safety switches (safe defaults shown).
# DRY_RUN=true: the strategy logs what it WOULD do and never sends an order.
DRY_RUN=true
# Orders are sent only when DRY_RUN=false AND ENABLE_ORDER_SUBMISSION=true.
ENABLE_ORDER_SUBMISSION=false

# Milestone 3B: Bybit TESTNET API credentials (read + trade permissions, NO withdrawal).
# Create them at https://testnet.bybit.com/app/user/api-management
# BYBIT_TESTNET_API_KEY=
# BYBIT_TESTNET_API_SECRET=
